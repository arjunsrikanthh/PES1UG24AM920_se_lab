@startuml
skinparam componentStyle uml2
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 11
skinparam roundCorner 8

skinparam component {
    BackgroundColor #FFF8E1
    BorderColor #E65100
    BorderThickness 1.5
    FontSize 12
    FontStyle bold
    FontColor #3E2723
}

skinparam interface {
    BackgroundColor #E1F5FE
    BorderColor #0277BD
    BorderThickness 1.5
    FontSize 10
    FontColor #263238
}

title **UML Component Diagram — Self-Service Coffee Kiosk System**\n(Student: Arjun Srikanth — PES1UG24AM920)

actor "Customer" as Customer
[EMV Card Reader\nHardware] as CardReaderHW
[Thermal Receipt Printer\nHardware] as PrinterHW
cloud "Bank Payment Gateway\n(TLS 1.3)" as BankGateway
database "Local Storage\n(SQLite)" as LocalDB

package "Self-Service Coffee Kiosk Software" {
    component "Touchscreen Kiosk UI\nComponent" as KioskUI <<component>>
    component "Order Manager\nComponent (Given)" as OrderMgr <<component>>
    component "Payment Service\nComponent (Given)" as PaymentSvc <<component>>
    component "Menu & Pricing Catalog\nComponent" as MenuCatalog <<component>>
    component "Printer Controller\nComponent" as PrinterCtrl <<component>>
}

interface "IOrderPlacement" as IOrderPlacement
interface "IMenuQuery" as IMenuQuery
interface "IPaymentProcess" as IPaymentProcess
interface "IPrintJob" as IPrintJob

Customer --> KioskUI : selects coffee & size
KioskUI ..( IOrderPlacement : <<use>>
IOrderPlacement -- OrderMgr

KioskUI ..( IMenuQuery : <<use>>
MenuCatalog -- IMenuQuery
OrderMgr ..( IMenuQuery : <<use>>

OrderMgr ..( IPaymentProcess : <<use>>\npayment request
IPaymentProcess -- PaymentSvc

OrderMgr ..( IPrintJob : <<use>>\nprint receipt
IPrintJob -- PrinterCtrl

PaymentSvc --> CardReaderHW : read chip/NFC
PaymentSvc --> BankGateway : authorize
PrinterCtrl --> PrinterHW : ESC/POS
MenuCatalog --> LocalDB : SQL query

@enduml
