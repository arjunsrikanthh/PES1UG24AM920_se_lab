@startuml
skinparam componentStyle uml2
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 11
skinparam roundCorner 8

skinparam component {
    BackgroundColor #EBF3FB
    BorderColor #1E5180
    BorderThickness 1.5
    FontSize 12
    FontStyle bold
    FontColor #0C2340
}

skinparam interface {
    BackgroundColor #FFF9C4
    BorderColor #F57F17
    BorderThickness 1.5
    FontSize 10
    FontColor #37474F
}

title **UML Component Diagram — Incident Escalation & On-Call Rotation Engine**\n(Problem Statement #48 | Student: Arjun Srikanth — PES1UG24AM920)

actor "Monitoring Systems\n(Prometheus / Datadog)" as MonitoringPlatform
actor "On-Call Engineer /\nIncident Commander" as Engineers

package "Incident Escalation & On-Call Rotation System" {
    package "Alert Ingestion & Escalation Pipeline" {
        component "Webhook Ingestion\nGateway" as IngestGW <<component>>
        component "Escalation &\nRules Engine" as EscalateEngine <<component>>
        component "Multi-Channel\nNotification Service" as NotifySvc <<component>>
    }

    package "Schedule, Triage & Post-Mortem Services" {
        component "Rotation & Schedule\nManager" as RotaMgr <<component>>
        component "Triage & Incident\nLifecycle Manager" as TriageMgr <<component>>
        component "Post-Mortem &\nTelemetry Store" as PostMortemSvc <<component>>
    }
}

[Telecom Cloud Gateway\n(Twilio Voice / SMS / SMTP)] as TelecomGateway
database "Distributed Data Store\n(PostgreSQL / Redis)" as DataStore

interface "IAlertWebhook" as IAlertWebhook
interface "IScheduleLookup" as IScheduleLookup
interface "IRotationConfig" as IRotationConfig
interface "INotifyDispatch" as INotifyDispatch
interface "IEscalationControl" as IEscalationControl
interface "IDashboardAPI" as IDashboardAPI
interface "IRemoteTriage" as IRemoteTriage
interface "IPostMortemTrigger" as IPostMortemTrigger

' Alert Ingress
MonitoringPlatform --> IAlertWebhook
IAlertWebhook -- IngestGW
IngestGW --> EscalateEngine : forward alert

' Scheduling
Engineers --> IRotationConfig
IRotationConfig -- RotaMgr
EscalateEngine ..( IScheduleLookup : <<use>>
IScheduleLookup -- RotaMgr

' Notification
EscalateEngine ..( INotifyDispatch : <<use>>
INotifyDispatch -- NotifySvc
NotifySvc --> TelecomGateway : phone, SMS, email (< 3s)

' Triage & Escalation Control
Engineers --> IDashboardAPI
IDashboardAPI -- TriageMgr
TelecomGateway --> IRemoteTriage : SMS ACK / voice keypress
IRemoteTriage -- TriageMgr

TriageMgr ..( IEscalationControl : <<use>>\nhalt 5-min timer
IEscalationControl -- EscalateEngine

' Post-Mortem
TriageMgr --> IPostMortemTrigger : on resolution
IPostMortemTrigger -- PostMortemSvc

' Database
RotaMgr --> DataStore
EscalateEngine --> DataStore
PostMortemSvc --> DataStore

@enduml
